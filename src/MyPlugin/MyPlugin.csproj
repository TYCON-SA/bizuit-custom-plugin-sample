<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MyPlugin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 🔴 BOTH pinned on purpose. Pinning only Core lets Abstractions float to a newer
         version whose interface has members the DevHost does not implement, and the template
         stops compiling without anyone noticing. That is exactly what happened before 2026-09-28. -->
    <PackageReference Include="Bizuit.Backend.Abstractions" Version="1.2.0" />
    <PackageReference Include="Bizuit.Backend.Core" Version="1.1.0" />
    <!-- 🔴 TEMPORARY (2026-11-19). Bizuit.Backend.Core 1.1.0 depends on Microsoft.Data.SqlClient 6.1.3,
         which brings System.Security.Cryptography.Pkcs 9.0.4: vulnerable (GHSA-846f-f764-76mx, high;
         GHSA-2fmv-rv2c-59x7). SqlClient 6.1.8, same 6.1 line, brings Pkcs 9.0.21, which fixes both.
         Every product created from this template inherited the vulnerability and its first pull
         request stopped on it. Remove this line when Bizuit.Backend.Core ships with SqlClient >= 6.1.8. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests can see internal types: see the comment on MeEndpoints.GetMe. -->
    <InternalsVisibleTo Include="MyPlugin.Tests" />
  </ItemGroup>

</Project>
